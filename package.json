{
  "name": "lab",
  "private": true,
  "author": "lin-coln",
  "repository": "https://github.com/Lin-coln/lab.git",
  "workspaces": {
    "packages": [
      "apps/*",
      "libs/*"
    ],
    "catalog": {
      "bun-plugin-tailwind": "latest",
      "chalk": "^5.4.1",
      "clsx": "^2.1.1",
      "electron": "^41",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "tailwindcss": "^4.1.12",
      "valtio": "^2.1.7",
      "ui": "workspace:*",
      "cc": "workspace:*"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint --report-unused-disable-directives",
    "format": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "oxfmt": "latest",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.19.0",
    "utils": "workspace:*"
  },
  "lint-staged": {
    "*": [
      "bun run lint",
      "bun run format"
    ]
  }
}
